{
  "manifest_version": 3,
  "name": "Video Download",
  "version": "0.5.0",
  "description": "Šalje video sa stranice u desktop aplikaciju Video Download (lična upotreba).",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["webRequest", "storage", "nativeMessaging", "scripting", "contextMenus"],
  "optional_permissions": ["cookies"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Video Download",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["drm-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["drm-bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
